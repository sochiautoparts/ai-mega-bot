# ════════════════════════════════════════════════════════════════════════════
# AI Mega Bot — Environment variables (copy to .env for local dev)
# In GitHub Actions these are set as repository Secrets.
# ════════════════════════════════════════════════════════════════════════════

# ── Telegram ──
BOT_TOKEN=          # token from @BotFather (REQUIRED)
# BOT_USERNAME and BOT_ID are auto-detected from the token at startup
# (via bot.get_me()), so they're OPTIONAL. Set them only to override.
BOT_USERNAME=       # e.g. aimega_bot  (optional, auto-detected)
BOT_ID=             # numeric bot id    (optional, auto-detected)
OWNER_ID=           # your numeric Telegram ID (from @userinfobot)
ADMIN_IDS=          # extra admin IDs, comma/space-separated (optional)

# ── GitHub PAT for 24/7 self-dispatch (REQUIRED for Actions) ──
GH_PAT_TOKEN=
GH_REPO=sochiautoparts/ai-mega-bot

# ── OpenClaw gateway ──
OPENCLAW_PORT=18789
OPENCLAW_STATE_DIR=.openclaw-state   # where openclaw.json + gateway.log live

# ── Database ──
DB_PATH=data/bot.db

# ── AI Providers (OPTIONAL — bot works on Pollinations free without any key) ──
# Free tiers:
GROQ_API_KEY=               # https://console.groq.com/keys  (Llama 3.3 70B, fast)
GEMINI_API_KEY=             # https://aistudio.google.com/apikey
OPENROUTER_API_KEY=         # https://openrouter.ai/keys  (free models)
HF_TOKEN=                   # https://huggingface.co/settings/tokens
CEREBRAS_API_KEY=           # https://cloud.cerebras.ai/
SAMBANOVA_API_KEY=          # https://cloud.sambanova.ai/
MISTRAL_API_KEY=            # https://console.mistral.ai/
# Paid (optional):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# ── Cloudflare Workers AI backup (optional, 2 accounts round-robin) ──
CF_ACCOUNT_ID_1=
CF_API_TOKEN_1=
CF_ACCOUNT_ID_2=
CF_API_TOKEN_2=

# ── Local Qwen2.5-7B model (optional, last-resort fallback or primary) ──
LOCAL_MODEL_PATH=data/qwen2.5-7b-instruct-q5_k_m-00001-of-00002.gguf
LOCAL_MODEL_THREADS=4
LOCAL_MODEL_PRIMARY=0        # 1/true/yes = try the local 7B FIRST for every request

# ── Behaviour tuning (optional) ──
GROUP_PROACTIVE_PROB=0.95   # chance bot comments on a non-directed group message
GROUP_MAX_PER_MINUTE=20
CHANNEL_REACTION_PROB=0.85  # chance bot reacts to a channel post
REACTION_PROB=0.65          # chance bot reacts to a group message
WEB_VERIFY_PROB=1.0         # chance bot web-searches news/events to supplement
LOG_LEVEL=INFO
