# ============================================================
#  REACTION SWARM — пример конфигурации (БЕЗ реальных токенов!)
# ============================================================
#  Скопируй этот файл в .env и заполни настоящими токенами:
#    cp .env.example .env
#  Получить токен: @BotFather -> /token -> выбрать бота.
#  Формат: NNNNNNNNN:AAAA...
#
#  ⚠ .env ИСКЛЮЧЁН из git через .gitignore — токены не попадут в репозиторий.
#  Для GitHub Actions используй Secrets (Settings → Secrets → Actions).
#
#  Боты должны быть АДМИНИСТРАТОРАМИ в каналах для реакций и комментариев.
# ============================================================

BOT_TOKEN_ALLSTARSPAY=
BOT_TOKEN_TIRES24=
BOT_TOKEN_ROSSKOZAP=
BOT_TOKEN_ACTIVGLOBAL=
BOT_TOKEN_RECARS=
BOT_TOKEN_BILET_AVIA=
BOT_TOKEN_KOLESPRO=
BOT_TOKEN_AUTOKOD=
BOT_TOKEN_ZAPONLINE=
BOT_TOKEN_LUKOILOIL=

# ------------------------------------------------------------
# Каналы для фильтрации (через запятую, без @).
# Пусто = реагировать во ВСЕХ каналах, где бот администратор.
# ------------------------------------------------------------
SWARM_CHANNELS=sochiautoparts,bmw_mpower_club,chasnastya,abakan_mebel
